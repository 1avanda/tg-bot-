    """Команда /stats - статистика продуктивности."""
    user_id = uid(update)
    today = datetime.now().date().isoformat()
    s = db.get_stats(user_id, today)
    adv = db.get_advanced_stats(user_id)
    
    text = (
        f"📊 *Ваша продуктивность:*\n\n"
        f"✅ Выполнено сегодня: {s['completed_today']}\n"
