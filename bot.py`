        f"🍅 Pomodoro сегодня: {s['pomodoros_today']}\n\n"
        f"📈 *Общий прогресс:*\n"
        f"• Завершено: {adv['completed_tasks']}/{adv['total_tasks']} ({adv['completion_rate']}%)\n"
        f"• Время фокуса: {adv['total_pomo_minutes']} мин\n"
        f"• Топ категория: {adv['top_category']}"
    )
    await update.message.reply_text(text, parse_mode="Markdown")

async def handle_ai_request(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработка всех текстовых сообщений через NLP и ИИ."""
    text = update.message.text
    action = await nlp.parse_user_text(text)
    
    if action["intent"] == "add_task":
        desc = nlp.describe_action(action)
        keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ Записать", callback_data="ai_confirm")],
            [InlineKeyboardButton("❌ Отмена", callback_data="ai_cancel")]
        ])
        await update.message.reply_text(f"Я понял ваш запрос:\n\n{desc}\n\nЗаписать?", reply_markup=keyboard)
        context.user_data["ai_pending_action"] = action
    elif action["intent"] == "list_tasks":
        await tasks.mytasks(update, context)
    elif action["intent"] == "start_pomodoro":
        await pomodoro.start_pomo(update, context)
    else:
        user_id = uid(update)
        user_stats = db.get_stats(user_id, datetime.now().date().isoformat())
        reply = await nlp.ai_assistant_reply(text, user_context=str(user_stats))
        await update.message.reply_text(reply)

async def ai_confirm_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Подтверждение записи задачи, предложенной ИИ."""
    query = update.callback_query
    await query.answer()
    action = context.user_data.get("ai_pending_action")
    if not action:
        await query.edit_message_text("Данные устарели. Попробуйте снова.")
        return
        
    user_id = uid(update)
    if action["intent"] == "add_task":
        db.add_task(
            user_id,
            action["title"],
            action["description"],
            action["category"],
            action["deadline"]
        )
        await query.edit_message_text(f"Задача «{action['title']}» успешно добавлена!")
    
    context.user_data.pop("ai_pending_action", None)

async def ai_cancel_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отмена действия, предложенного ИИ."""
    query = update.callback_query
    await query.answer()
    await query.edit_message_text("Действие отменено.")
    context.user_data.pop("ai_pending_action", None)

# ====================== Главная функция запуска ======================
def main():
    application = Application.builder().token(os.getenv("TELEGRAM_BOT_TOKEN")).build()

    # 1. Базовые команды
    application.add_handler(CommandHandler("start", start))
    application.add_handler(CommandHandler("help", help_command))
    application.add_handler(CommandHandler("stats", stats_command))
    application.add_handler(CommandHandler("tasks", tasks.mytasks))
    application.add_handler(CommandHandler("habits", habits.habits_list))
    application.add_handler(CommandHandler("pomo", pomodoro.start_pomo))
    application.add_handler(CommandHandler("newtask", tasks.newtask))

    # 2. Разговоры (ConversationHandlers)
    
    # Создание задачи
    task_conv = ConversationHandler(
        entry_points=[
            CommandHandler("newtask", tasks.newtask), 
            MessageHandler(filters.Regex(r"^Новая задача$"), tasks.newtask)
        ],
        states={
            TaskState.TITLE: [MessageHandler(filters.TEXT & ~filters.COMMAND, tasks.task_title)],
            TaskState.DESCRIPTION: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, tasks.task_description), 
                CallbackQueryHandler(tasks.skip_description, pattern="^skip_desc$")
            ],
            TaskState.CATEGORY: [CallbackQueryHandler(tasks.task_category)],
            TaskState.DEADLINE_DATE: [CallbackQueryHandler(tasks.task_deadline_date)],
            TaskState.CUSTOM_DATE: [MessageHandler(filters.TEXT & ~filters.COMMAND, tasks.task_custom_date)],
            TaskState.DEADLINE_TIME: [CallbackQueryHandler(tasks.task_deadline_time)],
            TaskState.CUSTOM_TIME: [MessageHandler(filters.TEXT & ~filters.COMMAND, tasks.task_custom_time)],
        },
        fallbacks=[CommandHandler("start", start)],
    )
    application.add_handler(task_conv)

    # Создание привычки
    habit_conv = ConversationHandler(
        entry_points=[
            CommandHandler("habits", habits.habits_list), 
            MessageHandler(filters.Regex(r"^Привычки$"), habits.habits_list), 
            CommandHandler("newhabit", habits.newhabit)
        ],
        states={
            HabitState.NAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, habits.habit_name)],
            HabitState.PERIOD_TYPE: [CallbackQueryHandler(habits.habit_period_type)],
            HabitState.PERIOD_VALUE: [
                CallbackQueryHandler(habits.habit_period_value), 
                MessageHandler(filters.TEXT & ~filters.COMMAND, habits.habit_period_value)
            ],
            HabitState.REMINDER_TIME: [MessageHandler(filters.TEXT & ~filters.COMMAND, habits.habit_reminder_time)],
        },
        fallbacks=[CommandHandler("start", start)],
    )
    application.add_handler(habit_conv)

    # Pomodoro таймер
    pomo_conv = ConversationHandler(
        entry_points=[
            CommandHandler("pomo", pomodoro.start_pomo), 
            MessageHandler(filters.Regex(r"^Pomodoro$"), pomodoro.start_pomo)
        ],
        states={
            PomoState.DURATION: [MessageHandler(filters.TEXT & ~filters.COMMAND, pomodoro.pomo_duration)],
            PomoState.TASK: [MessageHandler(filters.TEXT & ~filters.COMMAND, pomodoro.pomo_task)],
        },
        fallbacks=[CommandHandler("start", start)],
    )
    application.add_handler(pomo_conv)

    # 3. Обработка Callback-запросов (вне диалогов)
    application.add_handler(CallbackQueryHandler(tasks.task_detail, pattern="^task_"))
    application.add_handler(CallbackQueryHandler(tasks.done_task_handler, pattern="^done_"))
    application.add_handler(CallbackQueryHandler(tasks.delete_task_handler, pattern="^delete_task_"))
    application.add_handler(CallbackQueryHandler(tasks.toggle_reminder_handler, pattern="^toggle_reminder_"))
    application.add_handler(CallbackQueryHandler(habits.habit_detail, pattern="^habit_"))
    application.add_handler(CallbackQueryHandler(habits.check_habit_handler, pattern="^check_habit_"))
    application.add_handler(CallbackQueryHandler(habits.toggle_habit_reminder_handler, pattern="^toggle_habit_reminder_"))
    application.add_handler(CallbackQueryHandler(habits.delete_habit_handler, pattern="^delete_habit_"))
    application.add_handler(CallbackQueryHandler(pomodoro.stop_pomo, pattern="^stop_pomo$"))
    application.add_handler(CallbackQueryHandler(tasks.edit_task_start, pattern="^edit_task_"))
    application.add_handler(CallbackQueryHandler(habits.edit_habit_start, pattern="^edit_habit_start"))
    application.add_handler(CallbackQueryHandler(ai_confirm_handler, pattern="^ai_confirm$"))
    application.add_handler(CallbackQueryHandler(ai_cancel_handler, pattern="^ai_cancel$"))
    
    application.add_handler(CallbackQueryHandler(tasks.mytasks, pattern="^back_to_tasks$"))
    application.add_handler(CallbackQueryHandler(tasks.mytasks, pattern="^back_main$"))

    # 4. Обработка всех текстовых сообщений (ИИ-ассистент)
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_ai_request))

    # Планировщик задач (Проверка дедлайнов каждый час)
    application.job_queue.run_repeating(check_deadlines, interval=3600)

    # Запуск бота
    application.run_polling()

if __name__ == "__main__":
    main()
