async def edit_habit_name(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Обновление названия привычки."""
    habit_id = context.user_data.get("edit_habit_id")
    name = update.message.text.strip()
    try:
        if habit_id and name:
            import db
            db.update_habit(habit_id, name=name)
            await update.message.reply_text("Название обновлено.")
    except Exception as e:
        await update.message.reply_text(f"Ошибка обновления: {e}")
        
    context.user_data.pop("edit_habit_id", None)
    from bot import send_menu
    await send_menu(update, context)
    return ConversationHandler.END

