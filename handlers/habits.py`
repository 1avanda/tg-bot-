async def habit_period_type(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Обработка выбора типа периодичности."""
    query = update.callback_query
    await query.answer()
    ptype = query.data
    
    if ptype == "cancel":
        return ConversationHandler.END
        
    context.user_data["period_type"] = ptype
    
    if ptype == "every_2_days":
        context.user_data["period_value"] = "2"
        await ask_habit_time(update, context)
        return HabitState.REMINDER_TIME
    if ptype == "weekend":
        context.user_data["period_value"] = "6,7"
        await ask_habit_time(update, context)
        return HabitState.REMINDER_TIME
    if ptype == "daily":
        context.user_data["period_value"] = "1"
        await ask_habit_time(update, context)
        return HabitState.REMINDER_TIME
        
    if ptype == "weekly":
        keyboard = kb.habit_days_keyboard(context.user_data.get("selected_days", []))
        context.user_data["selected_days"] = []
        await query.edit_message_text(
            "Выберите дни недели, затем «Готово»:",
            reply_markup=keyboard,
        )
        return HabitState.PERIOD_VALUE
        
    if ptype == "custom_days":
        await query.edit_message_text("Введите число дней, например 3:")
        return HabitState.PERIOD_VALUE
        
    await query.edit_message_text("Ошибка. Начните заново.")
    return ConversationHandler.END

async def habit_period_value(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Обработка значения периода (дни недели или число дней)."""
    if update.callback_query:
        query = update.callback_query
        data = query.data
        if data.startswith("day_"):
            day = data.split("_")[1]
            selected = context.user_data.get("selected_days", [])
            if day in selected:
                selected.remove(day)
            else:
                selected.append(day)
            context.user_data["selected_days"] = sorted(selected)
            
            keyboard = kb.habit_days_keyboard(selected)
            await query.edit_message_text(
                "Выберите дни недели, затем «Готово»:",
                reply_markup=keyboard,
            )
            return HabitState.PERIOD_VALUE
        
        if data == "days_done":
            selected = context.user_data.get("selected_days", [])
            if not selected:
                await query.answer("Выберите хотя бы один день!", show_alert=True)
                return HabitState.PERIOD_VALUE
            
            context.user_data["period_value"] = ",".join(selected)
            await ask_habit_time(update, context)
            return HabitState.REMINDER_TIME
            
        if data == "cancel":
            return ConversationHandler.END
    
    text = update.message.text.strip() if update.message else ""
    if text.isdigit():
        context.user_data["period_value"] = text
        await ask_habit_time(update, context)
        return HabitState.REMINDER_TIME
    
    await update.message.reply_text("Пожалуйста, введите число дней.")
    return HabitState.PERIOD_VALUE

async def ask_habit_time(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Запрос времени напоминания о привычке."""
    await update.message.reply_text("Введите время напоминания ЧЧ:ММ, например 08:00")

async def habit_reminder_time(update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
    """Обработка ввода времени напоминания."""
    time_str = update.message.text.strip()
    try:
        datetime.strptime(time_str, "%H:%M")
    except ValueError:
        await update.message.reply_text("Неверный формат. Пример: 08:00")
        return HabitState.REMINDER_TIME
        
    context.user_data["reminder_time"] = time_str
    await finish_habit(update, context)
    return ConversationHandler.END

async def finish_habit(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Запись новой привычки в БД."""
    from bot import uid
    user_id = uid(update)
    
    try:
        HabitService.create_habit(
            user_id,
            context.user_data["habit_name"],
            context.user_data["period_type"],
            context.user_data["period_value"],
            context.user_data.get("reminder_time", "09:00"),
        )
        text = f"Привычка «{context.user_data['habit_name']}» создана!"
    except BotError as e:
        text = f"❌ Ошибка: {e.message}"
    
    if update.callback_query:
        await update.callback_query.edit_message_text(text)
    else:
        await update.message.reply_text(text)
        
    context.user_data.clear()
    from bot import send_menu
    await send_menu(update, context)
